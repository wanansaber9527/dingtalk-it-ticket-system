{
  "name": "quran-ticket-correction-console",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.9.0"
  },
  "description": "独立运行的趣然 IT 工单数据更正台",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 31023",
    "build": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js generate && node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-production.mjs",
    "validate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js validate",
    "test": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js generate && node --test tests/**/*.test.mjs",
    "check": "npm run validate && npm test && npm run build",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.29",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "deepmerge-ts": "8.0.2"
  }
}
